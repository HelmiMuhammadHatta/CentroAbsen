{
  "openapi": "3.0.0",
  "info": {
    "title": "CentroAbsen API",
    "version": "1.0.0",
    "description": "API Documentation for CentroAbsen HRIS."
  },
  "servers": [
    {
      "url": "http://localhost:4000/api/v1",
      "description": "Local Development"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Login Karyawan/User",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "example": "kry001@centroabsen.local" },
                  "password": { "type": "string", "example": "password123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Success" }
        }
      }
    },
    "/attendance/in": {
      "post": {
        "summary": "Absen Masuk",
        "tags": ["Attendance"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "latitude": { "type": "number", "example": -6.200000 },
                  "longitude": { "type": "number", "example": 106.816666 },
                  "locationId": { "type": "string", "example": "loc-hq-001" },
                  "photoBase64": { "type": "string", "example": "data:image/jpeg;base64,/9j/4AAQ..." }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Success" }
        }
      }
    },
    "/attendances/{id}/photo": {
      "get": {
        "summary": "Ambil Foto Presensi Terotorisasi (Private)",
        "tags": ["Attendance"],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "string", "example": "att-uuid-001" }
          }
        ],
        "responses": {
          "200": { "description": "Stream foto JPEG privat" },
          "401": { "description": "Tidak terotorisasi" },
          "403": { "description": "Akses ditolak" },
          "404": { "description": "Foto tidak ditemukan" }
        }
      }
    },
    "/finance/reimbursement": {
      "post": {
        "summary": "Ajukan Pengajuan Keuangan (Reimbursement)",
        "tags": ["Finance"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "example": "MEDICAL" },
                  "amount": { "type": "number", "example": 500000 },
                  "description": { "type": "string", "example": "Klaim berobat" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Success" }
        }
      }
    },
    "/finance/reimbursement/{id}/approve-manager": {
      "post": {
        "summary": "Persetujuan Atasan (Manager)",
        "tags": ["Finance"],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "string", "example": "reimb-test-001" }
          }
        ],
        "responses": {
          "200": { "description": "Success" }
        }
      }
    },
    "/finance/reimbursement/{id}/approve-ceo": {
      "post": {
        "summary": "Persetujuan CEO",
        "tags": ["Finance"],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "string", "example": "reimb-test-001" }
          }
        ],
        "responses": {
          "200": { "description": "Success" }
        }
      }
    },
    "/finance/reimbursement/{id}/disburse": {
      "post": {
        "summary": "Pencairan oleh Keuangan",
        "tags": ["Finance"],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "string", "example": "reimb-test-001" }
          }
        ],
        "responses": {
          "200": { "description": "Success" }
        }
      }
    }
  }
}
