generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum WorkArrangement {
  Office
  Hybrid
  Flexible
}

enum AttendanceType {
  CheckIn
  CheckOut
}

enum WorkMode {
  Office
  Home
  Anywhere
}

enum RequestStatus {
  Pending
  Approved
  Rejected
  Skipped
}

enum FinanceRequestKind {
  Reimbursement
  Purchase
}

enum Gender {
  Male
  Female
}

model Role {
  id         String   @id @default(uuid()) @db.Char(36)
  name       String   @unique
  created_at DateTime @default(now())

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id         String   @id @default(uuid()) @db.Char(36)
  name       String   @unique
  created_at DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_id       String   @db.Char(36)
  permission_id String   @db.Char(36)
  created_at    DateTime @default(now())

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model UserRole {
  user_id    String   @db.Char(36)
  role_id    String   @db.Char(36)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@map("user_roles")
}

model User {
  id                        String    @id @default(uuid()) @db.Char(36)
  nik                       String    @unique
  full_name                 String
  email                     String    @unique
  password_hash             String
  manager_id                String?   @db.Char(36)
  department_id             String?   @db.Char(36)
  position_id               String?   @db.Char(36)
  gender                    Gender?
  primary_work_location_id  String?   @db.Char(36)
  work_arrangement          WorkArrangement
  is_active                 Boolean   @default(true)
  photo_path                String?
  failed_login_count        Int       @default(0)
  locked_until              DateTime?

  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt

  manager               User?          @relation("UserToManager", fields: [manager_id], references: [id], onDelete: SetNull)
  subordinates          User[]         @relation("UserToManager")
  department            Department?    @relation(fields: [department_id], references: [id], onDelete: SetNull)
  position              Position?      @relation(fields: [position_id], references: [id], onDelete: SetNull)
  primary_work_location WorkLocation?  @relation(fields: [primary_work_location_id], references: [id], onDelete: SetNull)

  roles                 UserRole[]
  attendances           Attendance[]
  leave_balances        LeaveBalance[]
  leave_requests        LeaveRequest[]
  finance_requests      FinanceRequest[]
  employee_documents    EmployeeDocument[]
  refresh_tokens        RefreshToken[]
  password_reset_tokens PasswordResetToken[]

  @@map("users")
}

model Department {
  id         String   @id @default(uuid()) @db.Char(36)
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users     User[]
  positions Position[]

  @@map("departments")
}

model Position {
  id            String   @id @default(uuid()) @db.Char(36)
  name          String
  level         Int      @default(1)
  department_id String?  @db.Char(36)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  department Department? @relation(fields: [department_id], references: [id], onDelete: SetNull)
  users      User[]

  @@map("positions")
}

model EmployeeDocument {
  id             String   @id @default(uuid()) @db.Char(36)
  user_id        String   @db.Char(36)
  document_type  String
  file_path      String
  original_name  String
  content_type   String
  size_bytes     Int
  uploaded_at    DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("employee_documents")
}

model WorkLocation {
  id                     String   @id @default(uuid()) @db.Char(36)
  name                   String
  address                String
  latitude               Decimal  @db.Decimal(9,6)
  longitude              Decimal  @db.Decimal(9,6)
  radius_meters          Int
  work_start             String
  work_end               String
  late_tolerance_minutes Int      @default(0)
  is_active              Boolean  @default(true)

  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  users       User[]
  attendances Attendance[]

  @@map("work_locations")
}

model Attendance {
  id                           String         @id @default(uuid()) @db.Char(36)
  user_id                      String         @db.Char(36)
  work_date                    DateTime       @db.Date
  type                         AttendanceType
  server_time_utc              DateTime
  client_captured_at           DateTime
  latitude                     Decimal        @db.Decimal(9,6)
  longitude                    Decimal        @db.Decimal(9,6)
  accuracy_meters              Int
  distance_from_office_meters  Int?
  work_location_id             String?        @db.Char(36)
  work_mode                    WorkMode
  photo_path                   String
  status                       String
  status_minutes               Int            @default(0)
  status_note                  String?
  idempotency_key              String         @unique

  created_at                   DateTime       @default(now())
  updated_at                   DateTime       @updatedAt

  user          User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  work_location WorkLocation?   @relation(fields: [work_location_id], references: [id], onDelete: SetNull)
  flags         AttendanceFlag[]

  @@unique([user_id, work_date, type])
  @@index([user_id, work_date])
  @@map("attendances")
}

model AttendanceFlag {
  id            String   @id @default(uuid()) @db.Char(36)
  attendance_id String   @db.Char(36)
  flag          String
  created_at    DateTime @default(now())

  attendance Attendance @relation(fields: [attendance_id], references: [id], onDelete: Cascade)

  @@map("attendance_flags")
}

model Holiday {
  id         String   @id @default(uuid()) @db.Char(36)
  date       DateTime @unique @db.Date
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("holidays")
}

model LeaveType {
  id                   String   @id @default(uuid()) @db.Char(36)
  name                 String
  annual_quota_days    Int      @default(0)
  requires_attachment  Boolean  @default(false)
  requires_hr_approval Boolean  @default(false)
  eligible_gender      Gender?
  is_active            Boolean  @default(true)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  balances LeaveBalance[]
  requests LeaveRequest[]

  @@map("leave_types")
}

model LeaveBalance {
  id            String   @id @default(uuid()) @db.Char(36)
  user_id       String   @db.Char(36)
  leave_type_id String   @db.Char(36)
  year          Int
  quota         Int
  used          Int      @default(0)

  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  leave_type LeaveType @relation(fields: [leave_type_id], references: [id], onDelete: Cascade)

  @@unique([user_id, leave_type_id, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id              String        @id @default(uuid()) @db.Char(36)
  user_id         String        @db.Char(36)
  leave_type_id   String        @db.Char(36)
  start_date      DateTime      @db.Date
  end_date        DateTime      @db.Date
  total_work_days Int
  reason          String
  status          RequestStatus
  cancelled_at    DateTime?

  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  leave_type LeaveType @relation(fields: [leave_type_id], references: [id], onDelete: Cascade)

  @@map("leave_requests")
}

model FinanceRequest {
  id           String             @id @default(uuid()) @db.Char(36)
  user_id      String             @db.Char(36)
  kind         FinanceRequestKind
  category     String
  amount_idr   Decimal            @db.Decimal(18,2)
  description  String
  status       RequestStatus
  cancelled_at DateTime?

  created_at   DateTime           @default(now())
  updated_at   DateTime           @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("finance_requests")
}

model RequestAttachment {
  id             String   @id @default(uuid()) @db.Char(36)
  request_type   String
  request_id     String   @db.Char(36)
  file_path      String
  original_name  String
  content_type   String
  size_bytes     Int

  created_at     DateTime @default(now())

  @@map("request_attachments")
}

model ApprovalStep {
  id                  String        @id @default(uuid()) @db.Char(36)
  request_type        String
  request_id          String        @db.Char(36)
  step_order          Int
  role_required       String?
  assigned_to_user_id String?       @db.Char(36)
  status              RequestStatus
  acted_by            String?       @db.Char(36)
  acted_at            DateTime?
  note                String?

  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt

  @@index([assigned_to_user_id, status])
  @@map("approval_steps")
}

model Notification {
  id         String   @id @default(uuid()) @db.Char(36)
  user_id    String   @db.Char(36)
  title      String
  body       String
  link       String?
  is_read    Boolean  @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id, is_read])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Char(36)
  actor_id    String   @db.Char(36)
  action      String
  entity      String
  entity_id   String
  before_json String?  @db.LongText
  after_json  String?  @db.LongText
  ip          String?
  at          DateTime @default(now())

  @@map("audit_logs")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Char(36)
  user_id    String    @db.Char(36)
  hash       String
  family_id  String
  expires_at DateTime
  revoked_at DateTime?

  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Char(36)
  user_id    String    @db.Char(36)
  hash       String
  expires_at DateTime
  used_at    DateTime?

  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model AppSetting {
  key        String   @id
  value      String   @db.LongText
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("app_settings")
}
