# CentroAbsen Environment Variables Configuration
# Salin file ini menjadi `.env` sebelum menjalankan aplikasi.

# === SERVER & ENVIRONMENT ===
PORT=4000
NODE_ENV=development

# === DATABASE ===
# Pastikan MariaDB berjalan dan kredensial sesuai
DATABASE_URL="mysql://root:root@localhost:3306/centroabsen"

# === SECURITY & AUTHENTICATION ===
# Gunakan string acak yang panjang di production (misal: openssl rand -base64 32)
JWT_SECRET=super-secret-key-change-in-production
WEB_URL=http://localhost:3000

# === EMAIL & SMTP ===
# Konfigurasi SMTP untuk email notifikasi dan reset password
# Untuk development bisa menggunakan Mailpit di port 1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@centroabsen.local

# === SYSTEM CONFIGURATION ===
# Level logging: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Batasan Rate Limit (dalam milidetik dan jumlah maksimal per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

# Batas maksimal ukuran lampiran/file dalam MB
MAX_FILE_SIZE_MB=5

# === FITUR TAMBAHAN ===
# Set 'true' untuk mengaktifkan Swagger OpenAPI Docs di '/api/docs'
ENABLE_DOCS=true

# Aktifkan untuk validasi lokasi via Geocoding API (opsional)
GEOCODING_ENABLED=false
GEOCODING_API_URL=
